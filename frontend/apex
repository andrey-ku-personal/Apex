aside {
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  width: 16rem;
  height: 100%;
  background-color: #ffffff;
  color: #1a2421;
  border-right: 1px solid #e3e8e6;

  /* ===== ЛОГОТИП ===== */
  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 4rem;
    padding: 0 1.5rem;
    border-bottom: 1px solid #e3e8e6;
    flex-shrink: 0;

    .sidebar-logo-image {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
    }

    .sidebar-logo-title {
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1;

      span {
        color: #25a777;
      }
    }
  }

  /* ===== НАВИГАЦИЯ ===== */
  .sidebar-navigation {
    flex: 1 1 0%;
    padding: 0.75rem;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;

    .sidebar-navigation-title {
      color: rgba(26, 36, 33, 0.4);
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.75rem 0.75rem 0.5rem;
      margin: 0;

      &:not(:first-child) {
        margin-top: 1.25rem;
      }
    }
  }

  /* ===== ССЫЛКИ НАВИГАЦИИ ===== */
  .sidebar-nav-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    color: rgba(26, 36, 33, 0.65);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s ease;

    svg {
      flex-shrink: 0;
      color: currentColor;
    }

    &:hover {
      background-color: #f0f9f4;
      color: #1a2421;
    }

    &.active {
      background-color: rgba(37, 167, 119, 0.12);
      color: #25a777;
      font-weight: 600;

      svg {
        color: #25a777;
      }
    }
  }

  /* ===== КАРТОЧКА ПОЛЬЗОВАТЕЛЯ ===== */
  .sidebar-user {
    flex-shrink: 0;
    padding: 0.75rem;
    border-top: 1px solid #e3e8e6;

    .sidebar-user-card {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: background-color 0.15s ease;

      &:hover {
        background-color: #f0f9f4;
      }
    }

    .sidebar-user-avatar {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      background: linear-gradient(135deg, #25a777, #4ade80);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 600;
      flex-shrink: 0;
    }

    .sidebar-user-info {
      flex: 1 1 0%;
      min-width: 0;

      .sidebar-user-name {
        font-size: 0.875rem;
        font-weight: 500;
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .sidebar-user-email {
        font-size: 0.75rem;
        color: rgba(26, 36, 33, 0.5);
        margin: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    svg {
      flex-shrink: 0;
      color: rgba(26, 36, 33, 0.5);
    }
  }
}