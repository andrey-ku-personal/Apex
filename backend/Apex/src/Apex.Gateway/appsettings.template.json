{
  "ReverseProxy": {
    "Routes": {
      "users-auth": {
        "ClusterId": "users",
        "Match": { "Path": "/Auth/{**catch-all}" }
      },
      "users-users": {
        "ClusterId": "users",
        "Match": { "Path": "/Users/{**catch-all}" }
      },
      "portfolio": {
        "ClusterId": "portfolio",
        "Match": { "Path": "/api/v1/{**catch-all}" }
      }
    },
    "Clusters": {
      "users": { "Destinations": { "d1": { "Address": "http://localhost:5255" } } },
      "portfolio": { "Destinations": { "d1": { "Address": "http://localhost:5109" } } }
    }
  }
}