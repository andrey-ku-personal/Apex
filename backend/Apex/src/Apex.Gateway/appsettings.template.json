{
  "ReverseProxy": {
    "Routes": {
      "users-auth": {
        "ClusterId": "users",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/Auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "users-users": {
        "ClusterId": "users",
        "Match": { "Path": "/api/v1/Users/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" }
        ]
      },
      "portfolio": {
        "ClusterId": "portfolio",
        "Match": { "Path": "/api/v1/{**catch-all}" }
      }
    },
    "Clusters": {
      "users": { "Destinations": { "d1": { "Address": "http://localhost:5255" } } },
      "portfolio": { "Destinations": { "d1": { "Address": "http://localhost:5109" } } }
    }
  }
}