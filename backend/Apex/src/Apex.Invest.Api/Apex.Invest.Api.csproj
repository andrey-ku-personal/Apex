<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.24.1-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apex.Invest.Features\Apex.Invest.Features.csproj" />
  </ItemGroup>
	
  <PropertyGroup>
	<SourceAppSettingsConfigFile>appsettings.template.json</SourceAppSettingsConfigFile>
	<TargetAppSettingsConfigFile>appsettings.json</TargetAppSettingsConfigFile>
	<SourceNLogConfigFile>nlog.template.config</SourceNLogConfigFile>
	<TargetNLogConfigFile>nlog.config</TargetNLogConfigFile>
	<UserSecretsId>9162a258-5480-4bde-a777-8f86d1d62e53</UserSecretsId>
	<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerfileContext>..\..\..\..</DockerfileContext>
  </PropertyGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
	<Copy SourceFiles="$(SourceAppSettingsConfigFile)" DestinationFiles="$(TargetAppSettingsConfigFile)" Condition="!Exists($(TargetAppSettingsConfigFile))" />
	<Copy SourceFiles="$(SourceNLogConfigFile)" DestinationFiles="$(TargetNLogConfigFile)" Condition="!Exists($(TargetNLogConfigFile))" />
  </Target>

</Project>
